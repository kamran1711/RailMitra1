# RailFlow AI - Environment Configuration

# RailRadar Live API Configuration
# Paste your RailRadar API token here:
RAILRADAR_API_KEY=

# Base endpoint for RailRadar API
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# Rate Limiting Guardrails (Protects your quota)
RAILRADAR_MAX_CALLS_PER_MIN=15
RAILRADAR_MAX_CALLS_PER_DAY=250

# Server Port Settings
PORT=8080
HOST=0.0.0.0
